# Vercel & Production Environment Variables
# If deploying backend to Render, Railway, Fly.io, or VPS, set the full backend URL:
# VITE_API_BASE_URL=https://api.your-location-tracker.com/api
# VITE_WS_BASE_URL=wss://api.your-location-tracker.com

# For local development with Vite proxy, leave empty or default to:
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=
