# Global Docker Compose & App Environment Variables
PROJECT_NAME="Consent-Based Real-Time Location Sharing"
ENVIRONMENT="development"
DEBUG=True

# Backend JWT Secret
SECRET_KEY="super-secret-key-change-this-in-production-minimum-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=location_tracker
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Frontend Port
FRONTEND_PORT=5173
BACKEND_PORT=8000
