# Application Configuration
PROJECT_NAME="Consent-Based Real-Time Location Sharing"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Security & JWT
SECRET_KEY="super-secret-key-change-this-in-production-minimum-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="location_tracker"
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/location_tracker"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Location Tracking Policy Defaults
LOCATION_RETENTION_DAYS=30
MIN_DISTANCE_METERS=10.0
MIN_TIME_INTERVAL_SECONDS=5
